#!/bin/sh
set -eu
export PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C
ROOT='/Library/Application Support/AIKINGBOT/HostManager'
"$ROOT/aikingbot-host" --verify-installation
# Payload files have explicit root:wheel modes. Never recurse through tenant status or homes.
if [ -f "$ROOT/config.json" ] && [ ! -L "$ROOT/config.json" ]; then
  launchctl bootstrap system /Library/LaunchDaemons/app.aikingbot.host-manager.plist
fi
echo 'AIKINGBOT Host installed. Run sudo aikingbot-host setup, then sudo aikingbot-host verify.'
