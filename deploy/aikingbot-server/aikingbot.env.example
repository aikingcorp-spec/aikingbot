# AIKINGBOT server configuration. Copy to aikingbot.env (Docker) or
# /etc/aikingbot/aikingbot.env (systemd), chmod 600. Never commit the copy.

# ---- Compose-only placement (Docker mode) ----
COMPOSE_PROJECT_NAME=aikingbot-staging
# Dedicated host directory, never an existing OpenBot/OpenMausBot profile.
AIKING_DATA_ROOT=/srv/aikingbot-staging/server-data
# The edge is published on loopback; the host TLS proxy forwards to it.
AIKING_BIND_ADDRESS=127.0.0.1
AIKING_HTTP_PORT=18080
AIKING_WITH_BROWSER=1
# Only with compose.tls.yaml (Caddy owns 80/443):
# AIKING_DOMAIN=bot-staging.example.com

# ---- Public address ----
OMB_PUBLIC_URL=https://bot-staging.example.com
OMB_WEBHOOK_PUBLIC_URL=https://bot-staging.example.com

# ---- Access ----
# service: commands and agent shells inside the server are not the owner.
OMB_LOOPBACK_TRUST=service
AIKING_SERVER_LABEL=AIKINGBOT staging
# Print a one-time admin pairing code in the log at start (1/0).
AIKING_PAIR_ON_START=1
# Optional email sign-in allow-lists (comma-separated, "@domain" allowed).
# OMB_SIGNIN_EMAILS=
# OMB_SIGNIN_MEMBER_EMAILS=

# ---- Models (optional; can also be added in Settings → Connections) ----
# ANTHROPIC_API_KEY=

# ---- Voice: speech adapters (HTTPS, or loopback HTTP) ----
# OpenAI-compatible: e.g. https://api.openai.com/v1/audio/transcriptions and
# https://api.openai.com/v1/audio/speech (defaults whisper-1 / tts-1 / alloy), or a
# self-hosted compatible STT/TTS server on loopback. Tokens stay server-side.
# STT: multipart WAV in, {"text": "..."} out.
# AIKING_STT_URL=https://stt.example.com/v1/audio/transcriptions
# AIKING_STT_TOKEN=
# AIKING_STT_MODEL=
# TTS: JSON {input,text,voice,model,response_format:"pcm"} in, PCM16 out (x-sample-rate, default 24000).
# AIKING_TTS_URL=https://tts.example.com/v1/audio/speech
# AIKING_TTS_TOKEN=
# AIKING_TTS_MODEL=
# AIKING_TTS_VOICE=

# ---- Marketplace ----
# Reviewed catalog JSON inside the data volume (Docker: /data/...).
# AIKING_CATALOG_FILE=/data/catalog/aiking-catalog.json

# ---- Hosted services (leave empty unless you operate compatible services) ----
# AIKING_CLOUD_ORIGIN=
# OMB_CONTROL_PLANE_URL=
# OMB_COMPOSIO_BROKER_URL=
