# AIKINGBOT website/downloads/update feed. Copy to web.env (not committed).
COMPOSE_PROJECT_NAME=aikingbot-web-staging
# Host directory holding site/, downloads/ and updates/ (owned by the deploy user).
AIKING_WEB_ROOT=/srv/aikingbot-staging/web
# Public hostname routed by Traefik, and the paired web app it links to.
AIKING_WEB_HOST=aikingbot.example.com
AIKING_APP_URL=https://aikingbot-app.example.com
# Loopback port for local checks only.
AIKING_BIND_ADDRESS=127.0.0.1
AIKING_WEB_PORT=18090
