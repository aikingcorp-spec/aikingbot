# Stages the newest release, or stops AIKINGBOT, moves the staged release into place and starts AIKINGBOT
# again, when an owner, an admin or a permitted member asks for it in Server Settings > Updates.
[Unit]
Description=Update AIKINGBOT on request
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/AIKINGBOT/hosted/aikingbot-hosted-update request
# A download and an apply: the limits of aikingbot-update.service and aikingbot-update-apply.service.
TimeoutStartSec=45min
