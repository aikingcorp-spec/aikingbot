{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aikingbot-site-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "*.aikingbot-sites.aikingx.com/*",
      "zone_name": "aikingbot-sites.aikingx.com"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SITES",
      "bucket_name": "aikingbot-sites",
      "preview_bucket_name": "aikingbot-sites-test"
    }
  ]
}
