{
  "expo": {
    "name": "AIKINGBOT",
    "slug": "aikingbot",
    "platforms": ["ios", "android"],
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon.png",
    "scheme": "aikingbot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "run.aikingbot.mobile",
      "associatedDomains": ["applinks:aikingbot.aikingx.com"],
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Allow AIKINGBOT to connect to your desktop during local development.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/icons/app-icon.icon"
    },
    "android": {
      "package": "run.aikingbot.mobile",
      "icon": "./assets/icons/app-icon.png",
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "plugins": [
      "./plugins/with-rocketsim",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E6C5FA",
          "image": "./assets/icons/app-icon.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#181818"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AIKINGBOT to use your camera to scan QR codes.",
          "microphonePermission": "Allow AIKINGBOT to use the microphone to dictate messages.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AIKINGBOT to access the photos you choose to share.",
          "cameraPermission": "Allow AIKINGBOT to use your camera to add photos.",
          "microphonePermission": "Allow AIKINGBOT to use the microphone to dictate messages."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow AIKINGBOT to access the photos you choose to share.",
          "savePhotosPermission": "Allow AIKINGBOT to save images you download from a chat to your photo library.",
          "granularPermissions": ["photo"]
        }
      ],
      "expo-notifications",
      [
        "./plugins/with-ios-notification-sounds",
        {
          "sounds": [
            "./assets/sounds/aikingbot-task.wav",
            "./assets/sounds/aikingbot-warm.wav",
            "./assets/sounds/aikingbot-mech.wav",
            "./assets/sounds/aikingbot-bubble.wav",
            "./assets/sounds/aikingbot-press.wav"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-image",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow AIKINGBOT to use the microphone to dictate messages.",
          "speechRecognitionPermission": "Allow AIKINGBOT to turn your speech into message text."
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "run.aikingbot.mobile.ExpoWidgetsTarget",
          "groupIdentifier": "group.run.aikingbot.mobile",
          "enablePushNotifications": true,
          "frequentUpdates": true
        }
      ],
      [
        "./plugins/with-notification-service",
        {
          "targetName": "AIKINGBOTNotificationService",
          "bundleIdentifier": "run.aikingbot.mobile.NotificationService",
          "groupIdentifier": "group.run.aikingbot.mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eeec730f-c8f4-42c0-a750-64df8af14940"
      }
    },
    "owner": "aikingbot",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/eeec730f-c8f4-42c0-a750-64df8af14940"
    }
  }
}
