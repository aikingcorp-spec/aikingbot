export type Message = { role: "user" | "assistant"; content: string | Block[] };
export type Block = { type: "text"; text: string } | { type: "tool_call"; id: string; name: string; input: unknown } | { type: "tool_result"; toolCallId: string; content: string; isError: boolean };
export type Definition = { name: string; description?: string; risk: "read" | "side_effect" | "dangerous"; inputSchema: { type: "object"; [key: string]: unknown } };
export type ModelClient = { provider: string; create(request: { system: string; messages: Message[]; tools: Definition[] }, options?: { signal?: AbortSignal; onTextDelta?: (text: string) => void }): Promise<{ content: Block[]; stopReason: "end_turn" | "tool_use"; model: string; usage: Array<{ model: string; inputTokens: number; outputTokens: number; cacheReadTokens: number; cacheWriteTokens: number }>; fallbacks: [] }> };
export type ToolSource = { definitions(): Definition[]; call(name: string, input: unknown, context: { signal: AbortSignal; timeoutMs: number }): Promise<{ content: string; isError: boolean } | undefined> };
export type CoreEvent = { type: "text_start" | "text_delta" | "text_end"; messageId: string; delta?: string } | { type: "text"; text: string } | { type: "tool_call" | "tool_result"; id: string; name: string; input?: unknown; content?: string; isError?: boolean } | { type: "usage"; model: string; usage: Array<{ inputTokens: number; outputTokens: number; cacheReadTokens: number; cacheWriteTokens: number }> } | { type: "model_fallback"; fallback: { from: string; to: string; reason: string } } | { type: "step" | "tool_limit" };
export type Core = { chat: { send(text: string, hooks: { signal?: AbortSignal; onEvent?: (event: CoreEvent) => void; approver?: (request: { tool: string; risk: string; input: unknown; toolCallId?: string }) => Promise<boolean> }): Promise<{ text: string; status: string; cost: { usd: number; unpricedModels: string[] } }> }; warnings: string[]; close(): Promise<void> };
export function createCore(config: { signal?: AbortSignal; model: ModelClient; instructions?: string; transcriptPath?: string; skillsDir?: string; mcpServers?: Record<string, { command: string; args?: string[]; env?: Record<string, string>; cwd?: string; toolRisk?: Record<string, "read" | "side_effect" | "dangerous"> } | { type: "http" | "sse"; url: string; headers?: Record<string, string> }>; toolPolicy?: { allowDangerous?: string[] }; toolAllowed?: (name: string) => boolean; toolSources?: ToolSource[] }): Promise<Core>;
export class AnthropicModel implements ModelClient { constructor(options: { model?: string; apiKey?: string; baseURL?: string }); provider: string; create: ModelClient["create"]; }
export const DEFAULT_MODEL: string;
